# Public URL of this application
NEXT_PUBLIC_APP_URL=https://__APP_SLUG__.example.com

# Shared Fastify API
NEXT_PUBLIC_API_URL=https://api.example.com

# Hub URL used for navigation/sign-in entry point
NEXT_PUBLIC_HUB_URL=https://hub.example.com

# Firebase Analytics (public web config; analytics must still wait for consent)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Sentry (DSN may be public; auth token is build-time/server-only)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
