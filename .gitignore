# Dependencies
node_modules/
.pnpm-store/

# Build outputs
.next/
out/
dist/
build/
*.tsbuildinfo
next-env.d.ts

# Turborepo
.turbo/

# Test outputs
coverage/
playwright-report/
test-results/
blob-report/
playwright/.cache/
playwright/.auth/

# Environment files (never commit secrets) — keep the examples
.env
.env.*
!.env.example
!**/.env.example

# Local TLS certificates (mkcert) and keys
certs/
*.pem
*.key
*.crt

# Service worker build artefacts (generated by the PWA tooling)
**/public/sw.js
**/public/sw.js.map
**/public/swe-worker-*.js
**/public/workbox-*.js

# Sentry CLI local config (may contain tokens)
.sentryclirc
.env.sentry-build-plugin

# Database backups / local data
backups/
*.dump
*.sql.gz

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Credentials that must never be committed
*service-account*.json
application_default_credentials.json
